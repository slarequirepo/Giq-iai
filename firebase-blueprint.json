{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Group": {
      "title": "Group",
      "description": "Chat group metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdBy", "createdAt"]
    },
    "Member": {
      "title": "Member",
      "description": "Group membership info",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["owner", "admin", "member"] }
      },
      "required": ["userId", "joinedAt", "role"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "senderId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user profiles"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Chat groups"
    },
    "/groups/{groupId}/members/{userId}": {
      "schema": "Member",
      "description": "Members of a group"
    },
    "/groups/{groupId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages in a group"
    }
  }
}
